# Obsidian plugin settings can hold API keys and login tokens: never upload them
**/.obsidian/plugins/*/data.json

# Obsidian window layout (changes every time you click around)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json

# Copilot plugin cache (large, rebuilt automatically)
**/.copilot/

# OS files
.DS_Store
Thumbs.db
